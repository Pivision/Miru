{
  "name": "miru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --import ./scripts/sandbox-shim.mjs node_modules/vite/bin/vite.js dev",
    "build": "node --import ./scripts/sandbox-shim.mjs node_modules/vite/bin/vite.js build",
    "deploy": "npm run build && node --import ./scripts/sandbox-shim.mjs node_modules/wrangler/wrangler-dist/cli.js deploy",
    "db:init:local": "node --import ./scripts/sandbox-shim.mjs node_modules/wrangler/wrangler-dist/cli.js d1 execute DB --local --file=./src/server/db/schema.sql",
    "db:init:remote": "node --import ./scripts/sandbox-shim.mjs node_modules/wrangler/wrangler-dist/cli.js d1 execute DB --remote --file=./src/server/db/schema.sql",
    "typecheck": "node --import ./scripts/sandbox-shim.mjs node_modules/typescript/bin/tsc --noEmit",
    "check:layers": "node scripts/check-layers.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "harness": "node tests/serve.mjs",
    "test:e2e": "node tests/test.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.3",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "8.1.6",
    "wrangler": "4.154.0"
  }
}
